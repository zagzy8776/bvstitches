# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Private admin login password. Never commit the real value.
ADMIN_PASSWORD="change-this-to-a-long-random-password"

# 32+ character secret used to encrypt the admin HTTP-only session cookie.
ADMIN_SESSION_SECRET="change-this-to-a-long-random-secret-at-least-32-characters"

# Cloudinary (free account at https://cloudinary.com)
# 1. Dashboard → copy Cloud Name
# 2. Settings → Upload → Add upload preset → Signing mode: Unsigned
#    Enable both image and video uploads for that preset
# 3. Optional: set folder default to bvstitches/products
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset"

# Server-side aliases (optional; admin also reads VITE_ vars)
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset"
