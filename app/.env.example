# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Private admin login password. Never commit the real value.
ADMIN_PASSWORD="change-this-to-a-long-random-password"

# 32+ character secret used to encrypt the admin HTTP-only session cookie.
ADMIN_SESSION_SECRET="change-this-to-a-long-random-secret-at-least-32-characters"
